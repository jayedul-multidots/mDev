# -----------------------------------------------------------------------------
# mdev environment configuration.
#
# Copy to `.env` and adjust per environment (local, staging, production).
# `.env` is never committed. On servers it lives next to docker-compose.yml.
# Use single quotes for any value that contains a `$`.
# -----------------------------------------------------------------------------

# Compose project name. Also used as the Traefik router/service name, so it must
# be unique per environment on a shared Traefik host (e.g. mdev, mdev-staging).
COMPOSE_PROJECT_NAME=mdev

# Image used by the `wordpress` service. Locally it is built from ./Dockerfile;
# on servers the deploy script rewrites this to the tag CI just pushed.
WP_IMAGE=mdev/wordpress:local

# --- Routing (Traefik on the external `traenet` network) ---------------------
WP_DOMAIN=mdev.test
# Comma-separated Traefik entrypoints, e.g. `http` or `https`.
TRAEFIK_ENTRYPOINTS=http
# Set to true when the entrypoint terminates TLS in Traefik.
TRAEFIK_TLS=false

# --- WordPress ----------------------------------------------------------------
# local | development | staging | production
WP_ENVIRONMENT_TYPE=local
WP_HOME=http://mdev.test
WP_TITLE=mdev
# true behind a TLS-terminating proxy that forwards plain HTTP (e.g. Cloudflare).
WP_FORCE_SSL_PROXY=false
# Production images are immutable: keep plugin/theme installs disabled there.
WP_DISALLOW_FILE_MODS=false
WORDPRESS_DEBUG=1
WORDPRESS_TABLE_PREFIX=wp_

# Theme activated on provision.
WP_THEME=mdev-fse
# Plugins activated on provision: space-separated slugs, or `all`.
WP_ACTIVATE_PLUGINS="mdev-gb wordpress-seo redirection"

# First-run install (used only when the database has no WordPress install yet).
WP_AUTO_INSTALL=true
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me
WP_ADMIN_EMAIL=admin@mdev.test

# --- Database -----------------------------------------------------------------
DB_NAME=mdev
DB_USER=mdev
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# --- Salts --------------------------------------------------------------------
# Generate with `make salts`. Keep them stable per environment, otherwise every
# container recreate logs all users out.
WORDPRESS_AUTH_KEY=
WORDPRESS_SECURE_AUTH_KEY=
WORDPRESS_LOGGED_IN_KEY=
WORDPRESS_NONCE_KEY=
WORDPRESS_AUTH_SALT=
WORDPRESS_SECURE_AUTH_SALT=
WORDPRESS_LOGGED_IN_SALT=
WORDPRESS_NONCE_SALT=
