<?xml version="1.0"?>
<ruleset name="mdev">
	<description>WordPress Coding Standards for the mdev custom plugin and themes.</description>

	<file>wp-content/plugins/mdev-gb</file>
	<file>wp-content/themes/mdev-block</file>
	<file>wp-content/themes/mdev-fse</file>
	<file>docker/wordpress</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>

	<arg value="ps"/>
	<arg name="parallel" value="8"/>
	<arg name="extensions" value="php"/>
	<arg name="cache" value=".phpcs.cache"/>

	<rule ref="WordPress-Extra">
		<!-- New codebase convention: short array syntax (AGENTS.md section 3). -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
	</rule>
	<rule ref="Generic.Arrays.DisallowLongArraySyntax"/>
	<rule ref="WordPress-Docs"/>

	<!-- Self-hosted Docker deployment, not WordPress VIP: VIP sniffs disabled. -->

	<config name="minimum_wp_version" value="6.8"/>
	<config name="testVersion" value="8.3-"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="mdev-gb"/>
				<element value="mdev-block"/>
				<element value="mdev-fse"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<!-- wp-config include: defines core constants by design. -->
		<exclude-pattern>docker/wordpress/wp-config-mdev.php</exclude-pattern>
		<properties>
			<property name="prefixes" type="array">
				<element value="mdev"/>
			</property>
		</properties>
	</rule>

	<!-- PSR-4 class files in the plugin are named after their class. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>wp-content/plugins/mdev-gb/src/*</exclude-pattern>
	</rule>

	<!-- Runs before WordPress loads, inside wp-config.php. -->
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>docker/wordpress/wp-config-mdev.php</exclude-pattern>
	</rule>
</ruleset>
