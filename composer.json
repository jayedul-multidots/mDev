{
    "name": "mdev/site",
    "description": "mdev WordPress site: third-party plugins (installed on deploy) and repository-wide quality tooling.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "composer",
            "url": "https://wpackagist.org",
            "only": [
                "wpackagist-plugin/*",
                "wpackagist-theme/*"
            ]
        }
    ],
    "require": {
        "php": ">=8.3",
        "composer/installers": "^2.3",
        "wpackagist-plugin/redirection": "*",
        "wpackagist-plugin/wordpress-seo": "*"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.1",
        "wpackagist-plugin/query-monitor": "*",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Mdev\\Gb\\": "wp-content/plugins/mdev-gb/src/",
            "Mdev\\Gb\\Tests\\": "wp-content/plugins/mdev-gb/tests/",
            "Mdev\\Gb\\Tests\\Unit\\": "wp-content/plugins/mdev-gb/tests/unit/"
        }
    },
    "extra": {
        "installer-paths": {
            "wp-content/plugins/{$name}/": [
                "type:wordpress-plugin"
            ],
            "wp-content/themes/{$name}/": [
                "type:wordpress-theme"
            ]
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@composer --working-dir=wp-content/plugins/mdev-gb dump-autoload"
        ],
        "post-update-cmd": [
            "@composer --working-dir=wp-content/plugins/mdev-gb dump-autoload"
        ],
        "phpcs": "phpcs",
        "phpcs:fix": "phpcbf",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "test:integration": "tests/integration/vendor/bin/phpunit --configuration phpunit.integration.xml.dist",
        "check": [
            "@phpcs",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
