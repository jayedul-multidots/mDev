{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "name": "vaultrix/our-team",
  "version": "0.1.0",
  "title": "Our Team",
  "category": "vaultrix",
  "icon": "dashicons dashicons-groups dp-block-icon",
  "description": "This block describes information about team member of Vaultrix.",
  "keywords": ["our", "team"],
  "supports": {
    "html": false
  },
  "textdomain": "vaultrix",
  "attributes": {
		"blockID": {
			"type": "string",
			"default": ""
		},
		"showHeading": {
			"type": "boolean",
			"default": true
		},
		"showContent": {
			"type": "boolean",
			"default": true
		},
		"showTitle": {
			"type": "boolean",
			"default": true
		},
    	"showSubTitle": {
			"type": "boolean",
			"default": true
		},
		"heading": {
			"type": "string",
			"default": ""
		},
		"Content": {
			"type": "string",
			"default": ""
		},
		"contentAlignment": {
			"type": "string",
			"default": "center"
		},
		"headingColor": {
			"type": "string",
			"default": ""
		},
		"ContentColor": {
			"type": "string",
			"default": ""
		},
		"titleColor": {
			"type": "string",
			"default": ""
		},
    	"subTitleColor": {
			"type": "string",
			"default": ""
		},
		"bgColor": {
			"type": "string",
			"default": ""
		}
	},
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}