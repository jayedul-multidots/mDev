{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Dark",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#0b1120" },
				{ "slug": "surface", "name": "Surface", "color": "#1e293b" },
				{ "slug": "contrast", "name": "Contrast", "color": "#f1f5f9" },
				{ "slug": "muted", "name": "Muted", "color": "#cbd5e1" },
				{ "slug": "primary", "name": "Primary", "color": "#93c5fd" },
				{ "slug": "secondary", "name": "Secondary", "color": "#5eead4" }
			]
		}
	},
	"styles": {
		"elements": {
			"button": {
				"color": { "text": "var:preset|color|base" },
				":hover": {
					"color": { "background": "var:preset|color|contrast", "text": "var:preset|color|base" }
				}
			}
		}
	}
}
