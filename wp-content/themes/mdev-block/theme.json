{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "paper", "name": "Paper", "color": "#fbfaf7" },
				{ "slug": "stone", "name": "Stone", "color": "#f0eee9" },
				{ "slug": "ink", "name": "Ink", "color": "#1c1917" },
				{ "slug": "graphite", "name": "Graphite", "color": "#57534e" },
				{ "slug": "accent", "name": "Accent", "color": "#9a3412" }
			]
		},
		"layout": {
			"contentSize": "680px",
			"wideSize": "1080px"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "clamp(1.25rem, 2vw, 1.5rem)" },
				{ "slug": "50", "name": "L", "size": "clamp(2rem, 4vw, 3rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(3rem, 7vw, 5rem)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "serif",
					"name": "System Serif",
					"fontFamily": "Charter, \"Bitstream Charter\", \"Sitka Text\", Cambria, Georgia, serif"
				},
				{
					"slug": "sans",
					"name": "System Sans",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Arial, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.9rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.125rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.5rem", "fluid": { "min": "1.3rem", "max": "1.6rem" } },
				{ "slug": "x-large", "name": "Extra Large", "size": "2.5rem", "fluid": { "min": "1.9rem", "max": "2.75rem" } }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|paper",
			"text": "var:preset|color|ink"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|30",
			"padding": {
				"left": "var:preset|spacing|40",
				"right": "var:preset|spacing|40"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|serif",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.7"
		},
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|accent" },
				"typography": { "textDecoration": "underline" },
				":hover": { "typography": { "textDecoration": "none" } }
			},
			"heading": {
				"typography": { "fontWeight": "600", "lineHeight": "1.25" }
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|large" } },
			"button": {
				"color": {
					"background": "var:preset|color|ink",
					"text": "var:preset|color|paper"
				},
				"typography": { "fontFamily": "var:preset|font-family|sans" },
				":hover": {
					"color": { "background": "var:preset|color|accent" }
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "var:preset|font-size|small" }
			},
			"core/post-date": {
				"color": { "text": "var:preset|color|graphite" },
				"typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "var:preset|font-size|small" }
			},
			"core/site-title": {
				"typography": { "fontWeight": "600", "fontSize": "var:preset|font-size|large" },
				"elements": { "link": { "color": { "text": "var:preset|color|ink" }, "typography": { "textDecoration": "none" } } }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
